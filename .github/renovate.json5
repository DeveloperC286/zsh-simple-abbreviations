{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "automerge": true,
  "packageRules": [
    {
      // The GitHub Actions workflows are managed by Copier, updating them here
      // conflicts with the template updates. Disabled broadly first so any new
      // workflow the template adds is protected by default.
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      // Except these, which are not managed by Copier. The last matching
      // packageRule wins, so this allowlist must stay after the disable above.
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        ".github/workflows/continuous-integration.yml"
      ],
      "enabled": true
    }
  ],
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "commitMessageAction": "update",
      "commitMessageTopic": "Nix flake lock"
    }
  }
}
