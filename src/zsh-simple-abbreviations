#!/usr/bin/env zsh

emulate -L zsh

# Ensure the associative array exists so the --set sub-command does not abort
# fatally when ZSH_SIMPLE_ABBREVIATIONS is unset (e.g. the user unset it, or the
# function is called without the plugin's init having run). This is idempotent:
# it declares the array only if absent and preserves any existing contents.
typeset -gA ZSH_SIMPLE_ABBREVIATIONS

local KEY_REGEX="^[[:alnum:]]+$"
local CMD="zsh-simple-abbreviations"

# The `[[ ... =~ ... ]]` regex checks below set these match variables; keep them
# local so they do not leak into the interactive shell.
local MATCH MBEGIN MEND
local -a match mbegin mend

if [[ $# -eq 0 ]]; then
	echo "${CMD} no sub-command or arguments provided." >&2
	return 1
fi

case $1 in
--set)
	if [[ $# -ne 3 ]]; then
		echo "${CMD} set sub-command requires a key and value." >&2
		return 1
	fi

	local key=${2}
	local value=${3}

	if [[ ! ${key} =~ ${KEY_REGEX} ]]; then
		echo "${CMD} key '${key}' contains non-alphanumeric characters." >&2
		return 1
	fi

	ZSH_SIMPLE_ABBREVIATIONS[$key]="${value}"
	;;

--unset)
	if [[ $# -ne 2 ]]; then
		echo "${CMD} unset sub-command requires only a key." >&2
		return 1
	fi

	local key=${2}

	if [[ ! ${key} =~ ${KEY_REGEX} ]]; then
		echo "${CMD} key '${key}' contains non-alphanumeric characters." >&2
		return 1
	fi

	unset "ZSH_SIMPLE_ABBREVIATIONS[${key}]"
	;;

--help)
	echo "Usage: ${CMD} [--set KEY VALUE | --unset KEY | --list | --help]"
	echo "  --set KEY VALUE   Set an abbreviation for KEY to VALUE."
	echo "  --unset KEY       Remove the abbreviation for KEY."
	echo "  --list            List all abbreviations."
	echo "  --help            Display this help message."
	;;

--list)
	if [[ $# -ne 1 ]]; then
		echo "${CMD} list sub-command takes no other arguments." >&2
		return 1
	fi

	local key
	for key in ${(ko)ZSH_SIMPLE_ABBREVIATIONS}; do
		print -r -- "zsh-simple-abbreviations --set ${key} ${(qq)ZSH_SIMPLE_ABBREVIATIONS[$key]}"
	done
	;;

*)
	echo "${CMD} unrecognised sub-command." >&2
	return 1
	;;
esac
