#!/usr/bin/env zsh

emulate -L zsh

local KEY_REGEX="^[[:alnum:]]+$"
local CMD="zsh_simple_abbreviations"

# The `[[ ... =~ ... ]]` regex checks below set these match variables; keep them
# local so they do not leak into the interactive shell.
local MATCH MBEGIN MEND
local -a match mbegin mend

if [[ $# -eq 0 ]]; then
	echo "${CMD} no sub-command or arguments provided."
	return 1
fi

case $1 in
--set)
	if [[ $# -ne 3 ]]; then
		echo "${CMD} set sub-command requires a key and value."
		return 1
	fi

	local key=${2}
	local value=${3}

	if [[ ! ${key} =~ ${KEY_REGEX} ]]; then
		echo "${CMD} key '${key}' contains non-alphanumeric characters."
		return 1
	fi

	ZSH_SIMPLE_ABBREVIATIONS[$key]="${value}"
	;;

--unset)
	if [[ $# -ne 2 ]]; then
		echo "${CMD} unset sub-command requires only a key."
		return 1
	fi

	local key=${2}

	if [[ ! ${key} =~ ${KEY_REGEX} ]]; then
		echo "${CMD} key '${key}' contains non-alphanumeric characters."
		return 1
	fi

	unset "ZSH_SIMPLE_ABBREVIATIONS[${key}]"
	;;

--help)
	echo "Usage: ${CMD} [--set KEY VALUE | --unset KEY | --list | --help]"
	echo "  --set KEY VALUE   Set an abbreviation for KEY to VALUE."
	echo "  --unset KEY       Remove the abbreviation for KEY."
	echo "  --list            List all abbreviations."
	echo "  --help            Display this help message."
	;;

--list)
	if [[ $# -ne 1 ]]; then
		echo "zsh_simple_abbreviations list sub-command takes no other arguments."
		return 1
	fi

	local key
	for key in ${(ko)ZSH_SIMPLE_ABBREVIATIONS}; do
		echo "zsh-simple-abbreviations --set ${key} ${(qq)ZSH_SIMPLE_ABBREVIATIONS[$key]}"
	done
	;;

*)
	echo "${CMD} unrecognised sub-command."
	return 1
	;;
esac
